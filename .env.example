# WebbyCMS environment configuration
# Copy this file to .env and adjust the values for your deployment.

# application
APP_ENV=production
APP_DEBUG=false
APP_NAME=WebbyCMS
APP_URL=http://localhost

# database (optional - the framework runs without a database)
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# session
SESSION_NAME=webbycms_session
SESSION_LIFETIME=7200

# caching
PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=60

# security
# Set to true only after your forms have been migrated to include {{ csrf_field() }}
CSRF_ENFORCE=false
