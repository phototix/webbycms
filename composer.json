{
    "name": "webbycms/webbycms",
    "description": "Lightweight PHP framework for simple, scalable and stable websites.",
    "type": "project",
    "keywords": ["webbycms", "php", "framework", "cms"],
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "WebbyCMS\\": "src/WebbyCMS/"
        },
        "files": [
            "src/WebbyCMS/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WebbyCMS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src pages includes controller -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse src --level=5 --no-progress",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
